---
import type { CollectionEntry } from 'astro:content';
import { formatDate } from '@/utils/formatDate';

interface Props {
  entry: CollectionEntry<'blog'>;
}

const { entry } = Astro.props;
const { title, summary, date, type, tags } = entry.data;

const stamp = formatDate(date, 'compact');

const typeLabels: Record<typeof type, string> = {
  post: 'Post',
  snippet: 'Snippet',
  solution: 'Solution',
};
---

<a
  href={`/blog/${entry.id}`}
  class="group border-line hover:border-signal grid grid-cols-[3.5rem_1fr_auto] items-center gap-4 border-b py-5 transition-colors sm:grid-cols-[4.5rem_1fr_auto] sm:gap-6"
>
  <span class="text-ink-soft font-mono text-xs">{stamp}</span>

  <span class="min-w-0">
    <span class="flex items-center gap-2">
      
    </span>
    <span
      class="font-display text-ink group-hover:text-signal mt-1 block truncate text-lg transition-colors"
    >
      {title}
    </span>
    <span class="text-ink-soft hidden truncate text-sm sm:block">{summary}</span>
  </span>

  <span class="flex items-center gap-4">
    <span class="text-ink-soft hidden font-mono text-[11px] md:block">
      {tags.slice(0, 2).join(' · ')}
    </span>
    <span
      aria-hidden="true"
      class="text-ink-soft group-hover:text-signal transition-all group-hover:translate-x-1"
    >
      →
    </span>
  </span>
</a>
