---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/Button.astro';
import WorkRow from '@/components/WorkRow.astro';
import BlogRow from '@/components/BlogRow.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import { SITE } from '@/site.config';

import ScrollReveal from '../components/ScrollReveal.astro';

const allWork = await getCollection('work', ({ data }) => !data.draft);
const sorted = [...allWork].sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
const featured = sorted.filter((entry) => entry.data.featured);
const rest = sorted.filter((entry) => !entry.data.featured);
const selected = [...featured, ...rest].slice(0, 5);

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const recentPosts = allPosts.slice(0, 3);
---

<BaseLayout title={SITE.name}>
  <section class="mx-auto max-w-3xl px-6 pt-16 pb-20 sm:pt-24">
    <p class="text-ink-soft mb-6 inline-flex items-center gap-2 font-mono text-xs">
      <span class="bg-signal h-1.5 w-1.5 rounded-full" aria-hidden="true"></span>
      {SITE.status}
    </p>

    <h1 class="font-display text-ink max-w-2xl text-4xl leading-[1.1] font-medium sm:text-5xl">
      {SITE.tagline}
    </h1>

    <p class="text-ink-soft mt-6 max-w-md">
      {SITE.role} — based on the work below, not a list of buzzwords.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <Button href="/work" variant="primary">View the work →</Button>
      <Button href="https://www.linkedin.com/in/eric-a-perez" variant="ghost">Say hello</Button>
    </div>
  </section>

  <ScrollReveal>
    <section id="work" class="mx-auto max-w-3xl px-6 pb-20">
      <SectionHeading eyebrow="Selected work" count={allWork.length} />
      <div>
        {selected.map((entry) => <WorkRow entry={entry} />)}
      </div>
      {
        allWork.length > selected.length && (
          <div class="mt-6">
            <a
              href="/work"
              class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
            >
              View all {allWork.length} projects →
            </a>
          </div>
        )
      }
    </section>
  </ScrollReveal>

  <ScrollReveal>
    <section id="blog" class="mx-auto max-w-3xl px-6 pb-20">
      <SectionHeading eyebrow="From the blog" count={allPosts.length} />
      <div>
        {recentPosts.map((entry) => <BlogRow entry={entry} />)}
      </div>
      {
        allPosts.length === 0 && (
          <p class="text-ink-soft font-mono text-sm">Nothing published yet — check back soon.</p>
        )
      }
      {
        allPosts.length > recentPosts.length && (
          <div class="mt-6">
            <a
              href="/blog"
              class="text-ink-soft hover:text-signal font-mono text-xs transition-colors"
            >
              View all {allPosts.length} posts →
            </a>
          </div>
        )
      }
    </section>
  </ScrollReveal>

  <ScrollReveal>
    <section id="how_i_work" class="mx-auto max-w-3xl px-6 pb-20">
      <SectionHeading eyebrow="How I work" />
      <p class="text-ink-soft max-w-xl">
        <ScrollReveal delay={0}>
          <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">
            01 Understand the problem
          </h2>
          <p class="pt-1 pb-4">
            Interview stakeholders, review existing processes, and identify pain points.
          </p>
        </ScrollReveal>
        <ScrollReveal delay={100}>
          <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">
            02 Design the system
          </h2>
          <p class="pt-1 pb-4">
            Define the data model, workflow, permissions, and integration points.
          </p>
        </ScrollReveal>
        <ScrollReveal delay={200}>
          <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">
            03 Build the smallest useful version
          </h2>
          <p class="pt-1 pb-4">Deliver an end-to-end product before expanding the feature set.</p>
        </ScrollReveal>
        <ScrollReveal delay={300}>
          <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">
            04 Operationalize it
          </h2>
          <p class="pb-4">Add reporting, documentation, ownership, and support processes.</p>
        </ScrollReveal>
      </p>
      <Button href="/about" variant="ghost" class="mt-2">More about how I work →</Button>
    </section>
  </ScrollReveal>

  <ScrollReveal>
    <section id="capabilities" class="mx-auto max-w-3xl px-6 pb-20">
      <SectionHeading eyebrow="Capabilities" />

      <div class="mt-8 grid grid-cols-1 gap-4 sm:grid-cols-2">
        <ScrollReveal delay={0}>
          <div>
            <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">
              Platform Engineering
            </h2>
            <p class="pt-1 pb-4">
              Scoped applications, Flow Designer, integrations, portals, workspaces
            </p>
          </div>
        </ScrollReveal>
        <ScrollReveal delay={100}>
          <div>
            <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">
              Data & Reporting
            </h2>
            <p class="pt-1 pb-4">Data modeling, reporting, dashboards, and analytics</p>
          </div>
        </ScrollReveal>
        <ScrollReveal delay={200}>
          <div>
            <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">
              IT Asset Management
            </h2>
            <p class="pt-1 pb-4">
              Lifecycle automation, hardware governance, warranty and shipping workflows
            </p>
          </div>
        </ScrollReveal>
        <ScrollReveal delay={300}>
          <div>
            <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">
              Technical Toolkit
            </h2>
            <p class="pb-4">JavaScript, REST APIs, Angular, React, SQL/DAX/PowerQuery M, Astro</p>
          </div>
        </ScrollReveal>
      </div>
    </section>
  </ScrollReveal>

  <ScrollReveal>
    <section id="currently" class="mx-auto max-w-3xl px-6 pb-20">
      <SectionHeading eyebrow="Currently" />
      <p class="text-ink-soft max-w-xl">
        <ScrollReveal delay={0}>
          <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">Building</h2>
          <p class="pt-1 pb-4">
            IT asset management, integrations, and practical automation for complex IT operations
          </p>
        </ScrollReveal>
        <ScrollReveal delay={100}>
          <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">Learning</h2>
          <p class="pt-1 pb-4">
            AI-assisted development, generative AI, and prompt engineering for IT operations
          </p>
        </ScrollReveal>
        <ScrollReveal delay={300}>
          <h2 class="text-ink-soft font-mono text-xs tracking-[0.2em] uppercase">Writing about</h2>
          <p class="pt-1 pb-4">IT asset management, integrations, and practical automation</p>
        </ScrollReveal> 
      </p>
    </section>
  </ScrollReveal>

  <ScrollReveal delay={300}>
    <section id="contact" class="mx-auto max-w-3xl px-6 pb-24">
      <SectionHeading eyebrow="Let's talk" />
      <p class="font-display text-ink max-w-lg text-2xl sm:text-3xl">
        Let’s talk about building practical products for complex IT operations.
      </p>
      <Button href="https://www.linkedin.com/in/eric-a-perez" variant="ghost" class="mt-4"
        >Connect →</Button
      >
    </section>
  </ScrollReveal>
</BaseLayout>
